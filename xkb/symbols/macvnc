    replace key <I226> { type[Group1] = "TWO_LEVEL", [ NoSymbol, minus ] };
    replace key <I227> { type[Group1] = "TWO_LEVEL", [ NoSymbol, equal ] };
    replace key <I228> { type[Group1] = "TWO_LEVEL", [ NoSymbol, q ] };
