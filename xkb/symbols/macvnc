// Screen Sharing from a Mac sends:
//   Cmd    -> Alt_L
//   Option -> Meta_L
//
// WayVNC looks up those keysyms in THIS map to pick a Linux keycode, then
// Hyprland uses the same map the other way. Remapping <LALT> to Super or
// Meta makes Cmd land as Super+Alt together, so Cmd+1 / Cmd+W / Cmd+Space
// match neither bind. Leave Cmd as Alt_L; wrap-bind clones Super onto Alt.
//
// Screen Sharing also sends the unshifted keysym (XK_1) while Shift is
// held. WayVNC then clears every modifier to reach level 0, so
// Cmd+Shift+1 arrives as a bare 1. Putting 1 next to exclam on <AE01>
// makes Shift+/ type a keysym sequence instead of "?", so extra lookup
// keys <I216>..<I225> hold 1..0 on the shift level only. Real keys stay
// US: Shift+/ is still question.
//
// Comments must be C-style // (not Lua --). A leading "-" is a syntax error
// and wayvnc then crashes on client disconnect after a failed keyboard init.

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {
    include "us"

    name[Group1] = "English (VNC Mac)";

    replace key <LALT> {
        type[Group1] = "ONE_LEVEL",
        [ Alt_L ]
    };

    replace key <LWIN> {
        type[Group1] = "ONE_LEVEL",
        [ Meta_L ]
    };

    modifier_map Mod1 { <LWIN> };

    // Spare keys. Shift level only, so unshifted 1 still hits <AE01>.
    replace key <I216> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 1 ] };
    replace key <I217> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 2 ] };
    replace key <I218> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 3 ] };
    replace key <I219> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 4 ] };
    replace key <I220> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 5 ] };
    replace key <I221> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 6 ] };
    replace key <I222> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 7 ] };
    replace key <I223> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 8 ] };
    replace key <I224> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 9 ] };
    replace key <I225> { type[Group1] = "TWO_LEVEL", [ NoSymbol, 0 ] };
};
